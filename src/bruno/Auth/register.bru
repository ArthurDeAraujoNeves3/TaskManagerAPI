meta {
  name: register
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Ulysse Mérou",
    "email": "ulyssemerou@gmail.com",
    "password": {{PASSWORD}} // min = 10 max = 72
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
